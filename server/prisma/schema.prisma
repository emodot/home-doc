generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Requester {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String
  phoneNumber String
  age         String?
  gender      String?
  address     String?
  state       String?
  lga         String?
  createdAt   DateTime @default(now())

  careRequests CareRequest[]
}

model Beneficiary {
  id            String @id @default(uuid())
  firstName     String
  lastName      String
  phoneNumber   String
  age           String
  gender        String
  relationship  String
  address       String
  state         String
  lga           String

  careRequestId String
  careRequest   CareRequest @relation(fields: [careRequestId], references: [id])
}

model CareRequest {
  id               String   @id @default(uuid())
  isForSelf        Boolean
  planName         String
  paymentReference String   @unique
  paymentStatus    String
  paymentAmount    Int
  paymentCurrency  String   @default("NGN")
  createdAt        DateTime @default(now())

  requesterId   String
  requester     Requester     @relation(fields: [requesterId], references: [id])
  beneficiaries Beneficiary[]
}

model Plan {
  id        String   @id @default(uuid())
  name      String   @unique
  priceKobo Int
  period    String   @default("/month")
  bestFor   String
  features  String[]
  icon      String   @default("other")
  highlight Boolean  @default(false)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id                String   @id @default(uuid())
  username          String   @unique
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
}

model ContactSubmission {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String
  phoneNumber String
  message     String
  createdAt   DateTime @default(now())
}
