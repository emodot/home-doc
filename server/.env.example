PORT=4000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://homedoc:homedoc@localhost:5432/homedoc

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── How to get a Zoho Mail App Password ─────────────────────────
# 1. Sign in at https://mail.zoho.com with your homedoc.com mailbox
#    (Zoho Mail Free plan supports one custom domain — set that up
#    first at https://www.zoho.com/mail/ if you haven't already)
# 2. Go to https://accounts.zoho.com/home#security/security_pref
# 3. Turn ON "Multi-factor Authentication" (required for App Passwords)
# 4. Still on that page, go to the "App Passwords" section
# 5. Click "Generate New Password", name it "Home Doc" → Generate
# 6. Zoho shows you a password — copy it, paste it as EMAIL_PASS below
# 7. Set EMAIL_USER to your full Zoho mailbox address (e.g. hello@homedoc.com)
# 8. Save this file, then restart the server (npm start)
#
# Using a different provider instead? Just change SMTP_HOST/SMTP_PORT —
# everything else (EMAIL_USER/EMAIL_PASS) works the same way:
#   Gmail:  smtp.gmail.com : 587  (App Password from myaccount.google.com/security)
#   Resend: smtp.resend.com : 465 (EMAIL_USER=resend, EMAIL_PASS=your API key)
#   SES:    email-smtp.<region>.amazonaws.com : 587 (SMTP credentials from AWS console)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
EMAIL_USER=hello@homedoc.com
EMAIL_PASS=your-app-password
ADMIN_EMAIL=admin@homedoc.com
