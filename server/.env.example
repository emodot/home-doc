PORT=4000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://homedoc:homedoc@localhost:5432/homedoc

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── How to get a Gmail App Password ────────────────────────────
# 1. Go to https://myaccount.google.com/security
# 2. Make sure "2-Step Verification" is ON (turn it on if not)
# 3. In the search bar on that page, search "App passwords"
# 4. Click "App passwords"
# 5. Under "App name" type: Home Doc  → click Create
# 6. Google shows you a 16-character password (e.g. abcd efgh ijkl mnop)
# 7. Copy it, remove the spaces, paste it as EMAIL_PASS below
# 8. Save this file, then restart the server (npm start)
#
# Using a different provider instead? Just change SMTP_HOST/SMTP_PORT —
# everything else (EMAIL_USER/EMAIL_PASS) works the same way:
#   Zoho:   smtp.zoho.com : 465   (App Password from accounts.zoho.com/home#security)
#   Resend: smtp.resend.com : 465 (EMAIL_USER=resend, EMAIL_PASS=your API key)
#   SES:    email-smtp.<region>.amazonaws.com : 587 (SMTP credentials from AWS console)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
ADMIN_EMAIL=admin@homedoc.com

# ── Admin dashboard (separate from ADMIN_EMAIL above) ───────────
# JWT_SECRET: any long random string, used to sign admin login sessions
# ADMIN_USERNAME/ADMIN_PASSWORD: only used once, by `npm run seed`,
# to create the first admin login. Change/remove them after seeding.
JWT_SECRET=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
